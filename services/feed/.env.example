# GOLAZO feed service config. Copy to `.env` (gitignored; loaded automatically via
# dotenv). With NONE of these set, the service runs the simulator feed + rule-based
# watcher + bots on port 8787 (zero-config dev).

# --- Server ---
# WebSocket + HTTP port. Defaults to 8787 (the shared protocol default).
PORT=8787

# --- AI watcher (Claude) ---
# When set, Claude (Haiku 4.5) decides which moments are bettable and phrases
# them. When unset, the deterministic rule watcher from @golazo/core is used.
ANTHROPIC_API_KEY=
# Override the model id if needed. Default: claude-haiku-4-5-20251001 (fast).
# AI_MODEL=claude-haiku-4-5-20251001
# Hard latency cap before falling back to rules (ms). Default 2500.
# AI_TIMEOUT_MS=2500

# --- Feed selection ---
# auto   = try ESPN live game, fall back to sim on no-live-game/error (default)
# sim    = always the simulator (best for demos/tests)
# espn   = require a LIVE ESPN game; falls back to sim if none is in play
# replay = stream a real FINISHED match's play-by-play (set REPLAY_EVENT_ID)
FEED_MODE=auto
# ESPN soccer league slug. fifa.world = World Cup, eng.1 = Premier League, usa.1 = MLS.
ESPN_LEAGUE=fifa.world
# For FEED_MODE=replay: the ESPN event id to replay (e.g. 760437 = Croatia v England).
# REPLAY_EVENT_ID=760437
# How often to poll ESPN while a game is live (ms). Default 8000.
# ESPN_POLL_MS=8000

# --- On-chain (Solana devnet) ---
# Turn on the operator: the feed creates/locks/resolves a REAL on-chain market
# twin per market via the deployed parimutuel program. Off → play-money only.
CHAIN_ENABLED=1
# Upstream RPC (Helius/QuickNode URL with API key). NEVER ship this to the client —
# the app calls POST /rpc on the feed host, which proxies here.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Deployed program id (devnet). See DEPLOY.md.
GOLAZO_PROGRAM_ID=GicM38EbfZJ3azwbE34MPTFQgqQnxNyjrXPG9zr8Wbfu
# Operator keypair path (gitignored). Creates/locks/resolves markets; never holds
# user funds (the program's vault PDA does). Must hold devnet SOL for rent + fees.
OPERATOR_KEYPAIR=./operator-keypair.json

# --- Economics: fees / treasury ---
# Operator rake = the TRADE FEE taken off every settled market (win or lose). 0.06 = 6%.
RAKE=0.06
# Treasury wallet that collects the fees (Solana address). This is the revenue sink.
FEE_RECIPIENT=5kBBKSV2EUyLsa2sXoK9E1VVzmDXCaHnQiMfz8B8yJtP
# Deterministic seed base. Default 12345.
BASE_SEED=12345
# How many simulated bots fill each market's pool. Default 24.
BOT_COUNT=24
# If a locked market gets no resolution within this window, it settles. ms. Default 30000.
# RESOLVE_TIMEOUT_MS=30000
