  "private": true,
  "main": "expo-router/entry",
  "description": "GOLAZO mobile — the live 'bet the play' app (Expo / React Native / TypeScript).",
  "scripts": {
    "start": "EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start",
