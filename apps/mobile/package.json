{
  "name": "@golazo/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "GOLAZO mobile — the live 'bet the play' app (Expo / React Native / TypeScript).",
  "scripts": {
    "start": "EXPO_ROUTER_APP_ROOT=$PWD/app expo start",
