    "@golazo/core": "*",
    "@gorhom/bottom-sheet": "^4.6.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.2",
    "buffer": "^6.0.3",
    "expo": "~51.0.0",
    "expo-blur": "~13.0.2",
    "expo-constants": "~16.0.0",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
