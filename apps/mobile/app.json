{
  "expo": {
    "name": "GOLAZO",
    "slug": "golazo",
    "version": "0.1.0",
    "scheme": "golazo",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0a0b0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.golazo.mobile"
    },
    "android": {
      "package": "com.golazo.mobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "_comment": "Real on-chain MAINNET-BETA, USX settlement (6dp). Override per-build with EXPO_PUBLIC_* env vars. The demo/play-money loop is still reachable from Profile → Demo match.",
      "CHAIN_ENABLED": "1",
      "SOLANA_CLUSTER": "mainnet-beta",
      "GOLAZO_PROGRAM_ID": "3Ej5xzfeW9LFMK55JA1gZ7ew5hqkL8S7zh2tHabGmYYM",
      "USX_MINT": "6FrrzDk5mQARGc1TDYoyVnSyRdds1t4PbtohCD6p3tgG",
      "FEE_RECIPIENT": "5kBBKSV2EUyLsa2sXoK9E1VVzmDXCaHnQiMfz8B8yJtP",
      "PRIVY_APP_ID": "cmqm1002200120dl7cben6kwb",
      "_FEED_URL": "wss://YOUR-FEED-HOST  — set this (or EXPO_PUBLIC_FEED_URL) for a hosted web deploy; in local dev it auto-derives from the Metro host."
    }
  }
}
